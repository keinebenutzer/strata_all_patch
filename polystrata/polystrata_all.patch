index 00000000..465b6f3a
--- /dev/null
+++ b/src/poly/turbo_parity_test.cu
@@ -0,0 +1,294 @@
+// poly_turbo_parity_test.cu - the kolibri1 turbo caches: device kernels vs host references, bit for bit.
+//
+// Checks what the engine's readers rely on: the store kernels pack strata's kv_turbo bitstream exactly, the
+// staging dequantizer reproduces the readers' arithmetic, and fwht128 is the orthonormal self-inverse rotation
+// the contract needs.  Host and device run the identical float expressions in the identical order.
+#include "strata/poly/kernels.hpp"
+
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <vector>
+
+namespace {
+
+int fails = 0;
+void check(bool ok, const char* what) {
+    if (!ok) { std::fprintf(stderr, "FAIL: %s\n", what); ++fails; }
+}
+
+void* dalloc(size_t bytes) {
+    void* p = nullptr;
+    if (cudaMalloc(&p, bytes) != cudaSuccess) { std::fprintf(stderr, "cudaMalloc failed\n"); std::exit(1); }
+    return p;
+}
+
+// ---------------- host references (the same expressions, the same order) ----------------
+
+// fwht128, orthonormal, in the kernel's exact order: a warp a row emulated - four registers a lane, the low 5
+// index bits across lanes, the high 2 across the lane's registers.  The kernel shuffles within a stage from the
+// stage's own (pre-stage) values, so every stage works on a snapshot.
+void fwht128_host_exact(std::vector<float>& rows, size_t n_rows) {
+    constexpr float scale = 0.08838834764831845f;
+    std::vector<float> snap(128);
+    for (size_t r = 0; r < n_rows; ++r) {
+        float* row = rows.data() + r * 128;
+        for (int i = 0; i < 128; ++i) row[i] *= scale;
+        for (int h = 1; h < 32; h *= 2) {
+            snap = std::vector<float>(row, row + 128);
+            for (int lane = 0; lane < 32; ++lane)
+                for (int j = 0; j < 4; ++j) {
+                    const float val = snap[j * 32 + lane];
+                    const float val2 = snap[j * 32 + (lane ^ h)];
+                    row[j * 32 + lane] = (lane & h) == 0 ? val + val2 : val2 - val;
+                }
+        }
+        for (int h = 32; h < 128; h *= 2) {
+            const int step = h / 32;
+            snap = std::vector<float>(row, row + 128);
+            for (int lane = 0; lane < 32; ++lane)
+                for (int j = 0; j < 4; j += 2 * step)
+                    for (int k = 0; k < step; ++k) {
+                        const float a = snap[(j + k) * 32 + lane], b = snap[(j + k + step) * 32 + lane];
+                        row[(j + k) * 32 + lane] = a + b;
+                        row[(j + k + step) * 32 + lane] = a - b;
+                    }
+        }
+    }
+}
+
+// quantize one 32-value block exactly as the store kernels do; writes the packed bytes + the scale bits.
+uint16_t quant_block(int fmt, const float* xr, unsigned char* dst) {
+    float amax = 0.f;
+    for (int j = 0; j < 32; ++j) amax = std::fmax(amax, std::fabs(xr[j]));
+    if (fmt == 3) {
+        const __half dh = __float2half(amax / 0.875f);
+        const float hd = __half2float(dh) * 0.25f;
+        const float ihd = hd > 0.f ? 1.0f / hd : 0.f;
+        for (int b = 0; b < 12; ++b) dst[b] = 0;
+        for (int j = 0; j < 32; ++j) {
+            float q = std::nearbyintf(xr[j] * ihd + 3.5f);   // rintf: round-half-to-even, same as the device
+            q = std::fmin(std::fmax(q, 0.f), 7.f);
+            const unsigned c = (unsigned) q, bit = 3u * (unsigned) j;
+            dst[bit >> 3] |= (unsigned char) (c << (bit & 7));
+            if ((bit & 7) > 5) dst[(bit >> 3) + 1] |= (unsigned char) (c >> (8 - (bit & 7)));
+        }
+        return (uint16_t) __half_as_ushort(dh);
+    }
+    const __half dh = __float2half(amax / 0.75f);
+    const float hd = __half2float(dh) * 0.5f;
+    const float ihd = hd > 0.f ? 1.0f / hd : 0.f;
+    unsigned long long w = 0;
+    for (int j = 0; j < 32; ++j) {
+        float q = std::nearbyintf(xr[j] * ihd + 1.5f);
+        q = std::fmin(std::fmax(q, 0.f), 3.f);
+        w |= (unsigned long long) (unsigned) q << (2 * j);
+    }
+    for (int b = 0; b < 8; ++b) dst[b] = (unsigned char) (w >> (8 * b));
+    return (uint16_t) __half_as_ushort(dh);
+}
+
+// the readers' arithmetic on the host: the value of index gv of a row's packed arrays
+float kv_val_host(int fmt, const unsigned char* codes, const uint16_t* scales, size_t gv) {
+    const size_t blk = gv >> 5;
+    const int in = (int) (gv & 31);
+    const float s = __half2float(__ushort_as_half(scales[blk]));
+    if (fmt == 2) {
+        const unsigned b = codes[blk * 8 + (in >> 2)];
+        return ((float) ((b >> ((in & 3) << 1)) & 3) - 1.5f) * (s * 0.5f);
+    }
+    const unsigned char* p = codes + blk * 12 + ((in * 3) >> 3);
+    const unsigned w = (unsigned) p[0] | ((((in * 3) & 7) > 5 ? (unsigned) p[1] : 0u) << 8);
+    return ((float) ((w >> ((in * 3) & 7)) & 7) - 3.5f) * (s * 0.25f);
+}
+
+// ---------------- the tests ----------------
+
+void test_store(int fmt, const char* name) {
+    const int n = 128, nb = n / 32, rows = 37;
+    const size_t crow = (size_t) n * (fmt == 3 ? 3 : 2) / 8;
+    std::vector<float> h((size_t) rows * n);
+    srand(fmt == 3 ? 7 : 11);
+    for (auto& x : h) x = ((float) rand() / (float) RAND_MAX - 0.5f) * 8.f;
+    h[0] = 0.f; h[1] = -0.f;                       // the zero-block path
+    float* d_x = (float*) dalloc(h.size() * sizeof(float));
+    int8_t* d_codes = (int8_t*) dalloc((size_t) rows * crow + 16);   // a tail: the readers never read past, but
+    uint16_t* d_scales = (uint16_t*) dalloc((size_t) rows * nb * 2 + 8);   // a guard byte costs nothing here
+    cudaMemcpy(d_x, h.data(), h.size() * sizeof(float), cudaMemcpyHostToDevice);
+    cudaMemset(d_codes, 0xA5, (size_t) rows * crow + 16);
+    strata::poly::store_turbo(fmt, d_x, d_codes, d_scales, n, 0, rows, nullptr);
+    std::vector<unsigned char> got((size_t) rows * crow);
+    std::vector<uint16_t> got_s((size_t) rows * nb);
+    cudaMemcpy(got.data(), d_codes, (size_t) rows * crow, cudaMemcpyDeviceToHost);
+    cudaMemcpy(got_s.data(), d_scales, (size_t) rows * nb * 2, cudaMemcpyDeviceToHost);
+    std::vector<unsigned char> want((size_t) rows * crow);
+    std::vector<uint16_t> want_s((size_t) rows * nb);
+    for (int r = 0; r < rows; ++r)
+        for (int b = 0; b < nb; ++b) {
+            const int off = r * nb + b;
+            want_s[off] = quant_block(fmt, h.data() + (size_t) r * n + b * 32, want.data() + (size_t) r * crow + b * (fmt == 3 ? 12 : 8));
+        }
+    check(got == want, name);
+    check(got_s == want_s, "scale bits match the host quantizer");
+    cudaFree(d_x); cudaFree(d_codes); cudaFree(d_scales);
+}
+
+void test_dequant(int fmt, const char* name) {
+    const int width = 128, nb = width / 32, rows = 29;
+    const size_t crow = (size_t) width * (fmt == 3 ? 3 : 2) / 8;
+    std::vector<unsigned char> codes((size_t) rows * crow);
+    std::vector<uint16_t> scales((size_t) rows * nb);
+    srand(fmt == 3 ? 23 : 29);
+    for (int r = 0; r < rows; ++r)
+        for (int b = 0; b < nb; ++b) {
+            float block[32];
+            for (int j = 0; j < 32; ++j) block[j] = ((float) rand() / (float) RAND_MAX - 0.5f) * 6.f;
+            scales[r * nb + b] = quant_block(fmt, block, codes.data() + (size_t) r * crow + b * (fmt == 3 ? 12 : 8));
+        }
+    int8_t* d_codes = (int8_t*) dalloc(codes.size());
+    uint16_t* d_scales = (uint16_t*) dalloc(scales.size() * 2);
+    uint16_t* d_out = (uint16_t*) dalloc((size_t) rows * width * 2);
+    cudaMemcpy(d_codes, codes.data(), codes.size(), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_scales, scales.data(), scales.size() * 2, cudaMemcpyHostToDevice);
+    strata::poly::dequant_turbo_f16(fmt, d_codes, d_scales, d_out, width, 0, rows, nullptr);
+    std::vector<uint16_t> got((size_t) rows * width);
+    cudaMemcpy(got.data(), d_out, got.size() * 2, cudaMemcpyDeviceToHost);
+    int bad = 0;
+    for (int r = 0; r < rows; ++r)
+        for (int i = 0; i < width; ++i) {
+            const float v = kv_val_host(fmt, codes.data() + (size_t) r * crow, scales.data() + (size_t) r * nb, (size_t) i);
+            const uint16_t bits = __half_as_ushort(__float2half(v));
+            if (bits != got[(size_t) r * width + i]) ++bad;
+        }
+    check(bad == 0, name);
+    cudaFree(d_codes); cudaFree(d_scales); cudaFree(d_out);
+}
+
+void test_fwht() {
+    const size_t rows = 53;
+    std::vector<float> h(rows * 128), ref;
+    srand(37);
+    for (auto& x : h) x = ((float) rand() / (float) RAND_MAX - 0.5f) * 4.f;
+    float* d = (float*) dalloc(h.size() * sizeof(float));
+    cudaMemcpy(d, h.data(), h.size() * sizeof(float), cudaMemcpyHostToDevice);
+    strata::poly::fwht128_inplace_cuda(d, (int64_t) rows, nullptr);
+    std::vector<float> got(rows * 128);
+    cudaMemcpy(got.data(), d, got.size() * sizeof(float), cudaMemcpyDeviceToHost);
+    ref = h;
+    fwht128_host_exact(ref, rows);
+    int bad = 0;
+    for (size_t i = 0; i < got.size(); ++i)
+        if (std::memcmp(&got[i], &ref[i], 4) != 0) ++bad;   // bit-exact: same order, same adds
+    check(bad == 0, "fwht128 device matches the host reference bit for bit");
+    // self-inverse: fwht(fwht(x)) is x up to fp rounding
+    strata::poly::fwht128_inplace_cuda(d, (int64_t) rows, nullptr);
+    cudaMemcpy(got.data(), d, got.size() * sizeof(float), cudaMemcpyDeviceToHost);
+    double worst = 0;
+    for (size_t i = 0; i < got.size(); ++i)
+        worst = std::max(worst, (double) std::fabs(got[i] - h[i]) / std::max(1e-6, (double) std::fabs(h[i])));
+    check(worst < 1e-3, "fwht128 is its own inverse");
+    cudaFree(d);
+}
+
+void test_roundtrip() {
+    // rotate, store, read back: the error stays under half the centroid spacing over the stored scale
+    const int n = 128, nb = n / 32, rows = 41;
+    const size_t crow3 = (size_t) n * 3 / 8;
+    std::vector<float> h((size_t) rows * n);
+    srand(41);
+    for (auto& x : h) x = ((float) rand() / (float) RAND_MAX - 0.5f) * 5.f;
+    fwht128_host_exact(h, rows);   // the engine stores rotated rows
+    float* d_x = (float*) dalloc(h.size() * sizeof(float));
+    int8_t* d_codes = (int8_t*) dalloc((size_t) rows * crow3);
+    uint16_t* d_scales = (uint16_t*) dalloc((size_t) rows * nb * 2);
+    uint16_t* d_out = (uint16_t*) dalloc((size_t) rows * n * 2);
+    cudaMemcpy(d_x, h.data(), h.size() * sizeof(float), cudaMemcpyHostToDevice);
+    strata::poly::store_turbo(3, d_x, d_codes, d_scales, n, 0, rows, nullptr);
+    // debug: does the store match the host quantizer on this (rotated) data?
+    {
+        std::vector<unsigned char> codes((size_t) rows * crow3);
+        std::vector<uint16_t> sc((size_t) rows * nb);
+        cudaMemcpy(codes.data(), d_codes, codes.size(), cudaMemcpyDeviceToHost);
+        cudaMemcpy(sc.data(), d_scales, sc.size() * 2, cudaMemcpyDeviceToHost);
+        int bad = 0;
+        for (int r = 0; r < rows && bad < 3; ++r)
+            for (int b = 0; b < nb; ++b) {
+                unsigned char want[12];
+                const uint16_t ws = quant_block(3, h.data() + (size_t) r * n + b * 32, want);
+                if (std::memcmp(want, codes.data() + (size_t) r * crow3 + b * 12, 12) != 0 || ws != sc[r * nb + b]) {
+                    std::printf("  store mismatch row %d blk %d (scale want %04x got %04x)\n", r, b, ws, sc[r * nb + b]);
+                    for (int i = 0; i < 8; ++i)
+                        std::printf("    x=%.4f want c=%d\n", h[(size_t) r * n + b * 32 + i],
+                                    (want[(i * 3) >> 3] >> ((i * 3) & 7)) & 7);
+                    for (int i = 0; i < 8; ++i)
+                        std::printf("    got c=%d\n", (codes[(size_t) r * crow3 + b * 12 + ((i * 3) >> 3)] >> ((i * 3) & 7)) & 7);
+                    ++bad;
+                    break;
+                }
+            }
+        if (!bad) std::printf("  store matches the host quantizer on rotated data\n");
+    }
+    strata::poly::dequant_turbo_f16(3, d_codes, d_scales, d_out, n, 0, rows, nullptr);
+    std::vector<uint16_t> got((size_t) rows * n);
+    cudaMemcpy(got.data(), d_out, got.size() * 2, cudaMemcpyDeviceToHost);
+    {   // debug: reader arithmetic on the very bytes the store wrote, vs the kernel's output
+        std::vector<unsigned char> codes((size_t) rows * crow3);
+        std::vector<uint16_t> sc((size_t) rows * nb);
+        cudaMemcpy(codes.data(), d_codes, codes.size(), cudaMemcpyDeviceToHost);
+        cudaMemcpy(sc.data(), d_scales, sc.size() * 2, cudaMemcpyDeviceToHost);
+        std::printf("  row0 scale0=%04x codes=%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+                    sc[0], codes[0], codes[1], codes[2], codes[3], codes[4], codes[5], codes[6], codes[7], codes[8],
+                    codes[9], codes[10], codes[11]);
+        for (int i = 0; i < 8; ++i)
+            std::printf("  i=%d host-reader %.4f kernel %.4f\n", i,
+                        kv_val_host(3, codes.data(), sc.data(), (size_t) i),
+                        __half2float(__ushort_as_half(got[i])));
+        const int wr = 4, wi = 21;
+        std::printf("  row4 scale0=%04x codes=%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+                    sc[wr * nb], codes[(size_t) wr * crow3], codes[(size_t) wr * crow3 + 1], codes[(size_t) wr * crow3 + 2],
+                    codes[(size_t) wr * crow3 + 3], codes[(size_t) wr * crow3 + 4], codes[(size_t) wr * crow3 + 5],
+                    codes[(size_t) wr * crow3 + 6], codes[(size_t) wr * crow3 + 7], codes[(size_t) wr * crow3 + 8],
+                    codes[(size_t) wr * crow3 + 9], codes[(size_t) wr * crow3 + 10], codes[(size_t) wr * crow3 + 11]);
+        std::printf("  row4 i=21 host-reader %.4f kernel %.4f\n",
+                    kv_val_host(3, codes.data() + (size_t) wr * crow3, sc.data() + wr * nb, (size_t) wi),
+                    __half2float(__ushort_as_half(got[(size_t) wr * n + wi])));
+    }
+    double worst = 0;
+    int worst_r = -1, worst_i = -1;
+    for (int r = 0; r < rows; ++r) {
+        float amax = 0;
+        for (int i = 0; i < n; ++i) amax = std::max(amax, std::fabs(h[(size_t) r * n + i]));
+        for (int i = 0; i < n; ++i) {
+            const float v = __half2float(__ushort_as_half(got[(size_t) r * n + i]));
+            const double e = (double) std::fabs(v - h[(size_t) r * n + i]) / std::max(1e-9f, amax);
+            if (e > worst) { worst = e; worst_r = r; worst_i = i; }
+        }
+    }
+    std::printf("  worst at row %d value %d: want %.4f got %.4f\n", worst_r, worst_i,
+                h[(size_t) worst_r * n + worst_i], __half2float(__ushort_as_half(got[(size_t) worst_r * n + worst_i])));
+    check(worst <= 0.143 + 1e-9, "turbo3 round-trip error stays under amax / 7");
+    std::printf("  turbo3 round-trip worst error: %.4f x amax (bound 0.143)\n", worst);
+    if (worst > 0.2)
+        for (int i = 0; i < 8; ++i)
+            std::printf("  i=%d want %.4f got %.4f\n", i, h[i], __half2float(__ushort_as_half(got[i])));
+    cudaFree(d_x); cudaFree(d_codes); cudaFree(d_scales); cudaFree(d_out);
+}
+
+}   // namespace
+
+int main() {
+    if (cudaFree(nullptr) != cudaSuccess) { std::fprintf(stderr, "no CUDA device\n"); return 1; }
+    std::printf("=== poly turbo parity (kolibri1 caches, head_dim 128) ===\n");
+    test_store(2, "turbo2 store kernel packs the host bitstream bitwise");
+    test_store(3, "turbo3 store kernel packs the host bitstream bitwise");
+    test_dequant(2, "turbo2 staging dequant matches the readers' arithmetic");
+    test_dequant(3, "turbo3 staging dequant matches the readers' arithmetic");
+    test_fwht();
+    test_roundtrip();
+    if (fails) { std::printf("=== FAILED: %d ===\n", fails); return 1; }
+    std::printf("=== ALL TESTS PASSED ===\n");
+    return 0;
+}
